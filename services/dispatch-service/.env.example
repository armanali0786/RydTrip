PORT=3005
REDIS_URL=redis://localhost:6380
KAFKA_BROKERS=localhost:9094
DRIVER_SERVICE_URL=http://localhost:3002
# How long a driver stays reserved before the reservation would need
# releasing/renewing — see libraries/redis-client/src/driver-reservation-store.ts.
# Not currently released early on ride cancellation (Phase 8 territory).
RESERVATION_TTL_SECONDS=30
DISPATCH_SEARCH_RADIUS_KM=5
DISPATCH_CANDIDATE_LIMIT=5
# Circuit breakers (Phase 8) around Redis calls and the best-effort Driver
# Service status sync — see dispatch.service.ts.
DISPATCH_CIRCUIT_FAILURE_THRESHOLD=5
DISPATCH_CIRCUIT_RESET_TIMEOUT_MS=10000
