// Custom output path: npm workspaces hoist @prisma/client to the repo root,
// which would let each service's `prisma generate` clobber the others'
// generated types. Generating into a service-local folder and importing it
// by relative path avoids that collision entirely.
generator client {
  provider      = "prisma-client-js"
  output        = "../prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Owned exclusively by Driver Service — see docs/adr/004-database-per-service.md.
model Driver {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  vehicleType  String   @map("vehicle_type")
  city         String   @default("")
  licenseNumber              String  @default("") @map("license_number")
  vehicleRegistrationNumber  String  @default("") @map("vehicle_registration_number")
  insurancePolicyNumber      String  @default("") @map("insurance_policy_number")
  permitNumber               String? @map("permit_number")
  status       String   @default("OFFLINE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("drivers")
}
