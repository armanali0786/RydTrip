{
  "title": "RydTrip — Dispatch",
  "uid": "rydtrip-dispatch",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["rydtrip"],
  "panels": [
    {
      "id": 1,
      "title": "Rides processed by outcome (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(dispatch_rides_processed_total[1m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Circuit breaker state (0=CLOSED, 1=HALF_OPEN, 2=OPEN)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 2 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dispatch_circuit_breaker_state",
          "legendFormat": "{{circuit}}"
        }
      ]
    }
  ]
}
